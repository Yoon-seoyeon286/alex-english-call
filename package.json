{
  "name": "alex-english-call",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "prebuild": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "build:apk": "eas build --platform android --profile preview",
    "build:dev": "eas build --platform android --profile development"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~56.0.19",
    "expo-build-properties": "~56.0.25",
    "expo-constants": "~56.0.23",
    "expo-dev-client": "~56.0.24",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.16",
    "expo-router": "~56.2.18",
    "expo-splash-screen": "~56.0.14",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-incall-manager": "^4.2.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webrtc": "^124.0.8",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["react-native-webrtc", "react-native-incall-manager"],
        "listUnknownPackages": false
      }
    }
  }
