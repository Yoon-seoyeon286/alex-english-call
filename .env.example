# ---------------------------------------------------------------------------
# Mobile app env (EXPO_PUBLIC_* is embedded in the JS bundle — nothing secret!)
# Copy to `.env.local` for local dev; for EAS builds these live in eas.json.
# ---------------------------------------------------------------------------

# Base URL of your deployed Vercel backend (no trailing slash)
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000

# Shared app token — must match APP_TOKEN on the backend.
# This is NOT a login system; it only stops random people from burning your
# OpenAI credits if they find the endpoint. Rotate it whenever you like.
EXPO_PUBLIC_APP_TOKEN=change-me

# Optional overrides (defaults live in src/services/openai/config.ts)
# EXPO_PUBLIC_REALTIME_MODEL=gpt-realtime-2.1
# EXPO_PUBLIC_REALTIME_VOICE=cedar
# EXPO_PUBLIC_AI_NAME=Alex
