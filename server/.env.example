# Required — your OpenAI secret key. Set this in the Vercel dashboard
# (Project → Settings → Environment Variables). Never commit the real value.
OPENAI_API_KEY=sk-...

# Required — shared token between the app and this backend.
# Must match EXPO_PUBLIC_APP_TOKEN in the app. Any long random string works.
APP_TOKEN=change-me-to-something-long-and-random

# Optional model overrides
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=cedar
OPENAI_TEXT_MODEL=gpt-5.6
OPENAI_FAST_MODEL=gpt-5.6
