{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "android": {
        "image": "latest"
      },
      "node": "22.23.2"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE-ME.vercel.app",
        "EXPO_PUBLIC_APP_TOKEN": "REPLACE-ME"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE-ME.vercel.app",
        "EXPO_PUBLIC_APP_TOKEN": "REPLACE-ME"
      }
    },
    "production": {
      "extends": "base",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://REPLACE-ME.vercel.app",
        "EXPO_PUBLIC_APP_TOKEN": "REPLACE-ME"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
